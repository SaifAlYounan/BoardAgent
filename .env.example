# BoardAgent local VPS profile. Copy to .env; never commit real values.
BOARDAGENT_ENV=development
BOARDAGENT_DATABASE_URL=postgresql://boardagent:boardagent-local-only@postgres:5432/boardagent
# Set this to the one UUIDv7 printed by the one-use bootstrap command.
BOARDAGENT_ORGANIZATION_ID=018f0000-0000-7000-8000-000000000001
BOARDAGENT_PUBLIC_BASE_URL=https://boardagent.example.com
BOARDAGENT_AUTHORIZATION_MODE=builtin
BOARDAGENT_BLOB_ROOT=/var/lib/boardagent/blobs

# Local/test profile: the one required application secret. BoardAgent derives separate
# purpose keys with HKDF. Production refuses this setting and requires the four files below.
BOARDAGENT_DEV_MASTER_SECRET=replace-with-at-least-32-random-characters

# Production-only purpose-separated secret files (mounted read-only).
# BOARDAGENT_OAUTH_SIGNING_KEY_FILE=/run/secrets/oauth-signing-key.pem
# BOARDAGENT_EVIDENCE_SIGNING_KEY_FILE=/run/secrets/evidence-signing-key.pem
# BOARDAGENT_BROWSER_SESSION_KEY_FILE=/run/secrets/browser-session.key
# BOARDAGENT_DATA_KEK_FILE=/run/secrets/data-kek.key

# Fixed v1 lifetimes; other values are rejected at startup.
BOARDAGENT_ACCESS_TOKEN_TTL_SECONDS=900
BOARDAGENT_STAGE_TTL_SECONDS=600
BOARDAGENT_TRUSTED_PROXY_HOPS=1
BOARDAGENT_WEBHOOKS_ENABLED=false
# Encrypted artifact ceiling and chunk size (PostgreSQL caps each chunk at 10 MiB).
BOARDAGENT_EXPORT_MAX_BYTES=268435456
BOARDAGENT_EXPORT_CHUNK_BYTES=4194304
BOARDAGENT_LOG_LEVEL=info

# Compose-only values. The local database password is intentionally non-secret; production
# configuration must replace it. The Caddy domain is required only for the https profile.
POSTGRES_PASSWORD=boardagent-local-only
# RELEASE_IMAGE=boardagent:verification-current
# POSTGRES_IMAGE=boardagent-postgres:verification-current
# CADDY_IMAGE=boardagent-caddy:verification-current
# APP_ENV_FILE=.env
# Production uses `.env.production.example` plus `compose.production.yaml`; database
# passwords and signing/encryption keys are separate owner-only files, never values here.
# CADDY_DOMAIN=boardagent.example.com
# PUBLISHED_PORT=8787

# Recovery-overlay inputs. These deliberately stay outside the BOARDAGENT_* application
# namespace so the server's fail-closed unknown-setting check does not ingest operator config.
# RECOVERY_ROOT=/mnt/off-host/boardagent-recovery
# BACKUP_KEK_HOST_FILE=/run/boardagent-operator/backup-kek.key
# BACKUP_KEY_ID=018f0000-0000-7000-8000-000000000099

# Optional deployment restriction. Values are exact server-issued client IDs or
# cryptographically verified Client ID Metadata Document URLs, never asserted software names.
# BOARDAGENT_CLIENT_ALLOWLIST=

# OIDC mode only; subjects must be pre-linked by the secretariat and are never provisioned.
# BOARDAGENT_OIDC_ISSUER=https://identity.example.com
# BOARDAGENT_OIDC_CLIENT_ID=boardagent
# BOARDAGENT_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc-client-secret

# Optional production historical data-key manifest, mounted as a protected file.
# See docs/decisions/retained-data-key-runtime-v1.md. This is not a rotation command.
# BOARDAGENT_RETAINED_DATA_KEYS_FILE=/run/boardagent-secrets/retained-data-keys.json
