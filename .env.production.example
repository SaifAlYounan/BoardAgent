# Non-secret application settings for compose.yaml + compose.production.yaml.
# Supply all secret host-file paths to Compose separately; never put secret values here.
BOARDAGENT_ENV=production
BOARDAGENT_ORGANIZATION_ID=018f0000-0000-7000-8000-000000000001
BOARDAGENT_PUBLIC_BASE_URL=https://boardagent.example.com
BOARDAGENT_AUTHORIZATION_MODE=builtin
BOARDAGENT_BLOB_ROOT=/var/lib/boardagent/blobs
BOARDAGENT_OAUTH_SIGNING_KEY_FILE=/run/boardagent-secrets/oauth_signing_key
BOARDAGENT_EVIDENCE_SIGNING_KEY_FILE=/run/boardagent-secrets/evidence_signing_key
BOARDAGENT_BROWSER_SESSION_KEY_FILE=/run/boardagent-secrets/browser_session_key
BOARDAGENT_DATA_KEK_FILE=/run/boardagent-secrets/data_kek
# Fixed v1 lifetimes; other values are rejected at startup.
BOARDAGENT_ACCESS_TOKEN_TTL_SECONDS=900
BOARDAGENT_STAGE_TTL_SECONDS=600
BOARDAGENT_TRUSTED_PROXY_HOPS=1
BOARDAGENT_WEBHOOKS_ENABLED=false
BOARDAGENT_EXPORT_MAX_BYTES=268435456
BOARDAGENT_EXPORT_CHUNK_BYTES=4194304
BOARDAGENT_LOG_LEVEL=info
