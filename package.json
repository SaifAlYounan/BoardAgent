{
  "name": "boardagent",
  "version": "0.0.0-private-beta",
  "private": true,
  "description": "Self-hosted MCP-native board governance system of record",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": "11.24.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && oxlint --deny-warnings artifacts lib scripts tests && depcruise --config dependency-cruiser.config.cjs artifacts lib scripts tests",
    "lint:eslint": "eslint .",
    "lint:oxlint": "oxlint --deny-warnings artifacts lib scripts tests",
    "lint:architecture": "depcruise --config dependency-cruiser.config.cjs artifacts lib scripts tests",
    "registry:generate": "tsx scripts/src/generate-registry.ts",
    "registry:check": "tsx scripts/src/check-registry.ts",
    "test": "vitest run --no-file-parallelism --maxWorkers=1",
    "test:phase0": "vitest run tests/phase0 --no-file-parallelism --maxWorkers=1",
    "test:coverage": "vitest run --coverage --no-file-parallelism --maxWorkers=1",
    "test:mutation": "stryker run",
    "supply-chain:generate": "tsx scripts/src/generate-supply-chain.ts",
    "supply-chain:check": "tsx scripts/src/generate-supply-chain.ts --check",
    "sbom": "corepack pnpm supply-chain:generate",
    "licenses": "corepack pnpm supply-chain:generate",
    "scan:image": "tsx scripts/src/scan-release-image.ts",
    "verify:phase0": "corepack pnpm registry:check && corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test:phase0",
    "verify:phase1-performance": "tsx tests/performance/verify-phase1-performance.ts",
    "verify:phase1": "tsx scripts/src/verify-release.ts phase1",
    "verify:private-beta": "tsx scripts/src/verify-release.ts private-beta",
    "verify:release": "tsx scripts/src/verify-release.ts release"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@simplewebauthn/server": "13.3.3",
    "canonicalize": "4.0.0",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.10",
    "oidc-provider": "9.11.4",
    "openid-client": "6.8.7",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.2.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.1",
    "fast-check": "4.9.0",
    "license-checker-rseidelsohn": "5.0.1",
    "mcporter": "0.13.7",
    "openclaw": "2026.7.1",
    "oxlint": "1.80.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
